# true  = mode demo penuh, semua data dummy (tanpa backend)
# false = endpoint yang sudah ada di backend memakai API asli; sisanya tetap dummy
VITE_USE_MOCK=false

# Alamat API backend (lihat backend/README.md). Origin frontend harus sama dengan FRONTEND_URL di backend/.env.
VITE_API_BASE_URL=http://localhost:8000/api/v1
